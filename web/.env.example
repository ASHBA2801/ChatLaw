# Web application environment.
# Copy this file to web/.env and fill in real values. Never commit real keys.

# PostgreSQL connection string (shared database, see database/).
# Local Docker pgvector container (see docker/postgres/compose.yml).
# Host port is 5433.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/chatlaw?schema=public"

# Server-side RAG proxy configuration. Never expose the secret through
# NEXT_PUBLIC_* variables.
RAG_API_URL=http://127.0.0.1:8000
RAG_API_SECRET=replace-with-a-long-random-service-secret

# Gemini API Key for server-side Multimodal Speech-to-Text and generation
GEMINI_API_KEY=

# Auth.js (Google). Keep these server-side only. Never use NEXT_PUBLIC_*.
# Generate AUTH_SECRET with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-auth-secret-at-least-32-characters
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_TRUST_HOST=true

# Optional Phase 20 resource providers. When unset, ChatLaw uses curated
# official court / bar-council directories from legal-data/.
COURT_PROVIDER_URL=
ADVOCATE_PROVIDER_URL=
