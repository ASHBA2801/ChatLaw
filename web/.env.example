# Web application environment.
# Copy this file to web/.env and fill in real values. Never commit real keys.

# PostgreSQL connection string (shared database, see database/).
# Local Docker pgvector container (see docker/postgres/compose.yml).
# Host port is 5433.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/chatlaw?schema=public"

# Gemini (used later for embeddings + chat; not required for the UI shell)

# Gemini (used by the RAG-03 embedding CLI; not required for the UI shell)
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_EMBEDDING_MODEL=

# RAG-03 embedding configuration (set these in rag-engine/.env for ingestion).
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=32

# RAG-03 embedding ingestion configuration (shared with rag-engine/.env)
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=32

# RAG Engine API base URL (future; the web app calls the RAG Engine over HTTP)
# RAG_API_URL=http://localhost:8000/api/v1
