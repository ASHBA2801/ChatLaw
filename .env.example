# ChatLaw Docker Compose settings.
#   cp .env.example .env   then fill in the values marked REQUIRED.
# Never commit .env.

# --- REQUIRED ---------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Shared secret between the web app and the RAG engine: openssl rand -hex 32
RAG_API_SECRET=
# Gemini API key (embeddings, generation, speech).
GEMINI_API_KEY=

# --- Google sign-in (optional until you need login) ---------------------------
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Database ---------------------------------------------------------------
# Use URL-safe characters in the password (it is placed inside DATABASE_URL).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=chatlaw

# --- Models -----------------------------------------------------------------
GEMINI_GENERATION_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2-preview

# --- Optional ---------------------------------------------------------------
# Public URL of the web app (CORS origin for the RAG engine).
CHATLAW_FRONTEND_ORIGIN=http://localhost:3000
COURT_PROVIDER_URL=
ADVOCATE_PROVIDER_URL=
# Host ports.
WEB_HOST_PORT=3000
RAG_HOST_PORT=8000
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6379
