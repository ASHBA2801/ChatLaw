generator client {
  provider = "prisma-client"
  // Generated client is consumed by the Next.js app (web/), which imports it
  // via `@/lib/generated/prisma/client`. Relative to this file's directory.
  output   = "../../web/lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// ChatLaw database schema
//
// Legal documents preserve their hierarchical structure (Act -> Chapter ->
// Section -> Subsection -> Clause) rather than being flattened into anonymous
// text chunks. Chunks carry the hierarchical coordinates of the source text so
// retrieval can reconstruct context and cite precise locations.
//
// pgvector is used for embeddings. The `vector` column type is exposed through
// Prisma's `Unsupported("vector(N)")` type, which means it is not queryable via
// the typed client — vector operations are performed through the dedicated
// vector-search abstraction in lib/rag/vector-search.ts.
// ============================================================================

// ---------------------------------------------------------------------------
// legal_documents — a single legal instrument (Act, Rule, Regulation, etc.)
// ---------------------------------------------------------------------------
model LegalDocument {
  id              String   @id @default(cuid())
  title           String
  documentType    String // e.g. "act", "rule", "regulation", "notification"
  authority       String? // issuing body, e.g. "Parliament of India"
  sourceUrl       String?
  publicationDate DateTime?
  effectiveDate   DateTime?
  version         String?
  language        String   @default("en")
  contentHash     String? // integrity check of the source content
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  chunks  LegalChunk[]
  sources LegalSource[]

  @@index([documentType])
  @@index([language])
  @@index([title])
  @@map("legal_documents")
}

// ---------------------------------------------------------------------------
// legal_chunks — a hierarchical slice of a legal document
// ---------------------------------------------------------------------------
model LegalChunk {
  id            String   @id @default(cuid())
  documentId    String
  content       String
  sectionNumber String?
  subsection    String?
  chapter       String?
  clause        String?
  pageNumber    Int?
  chunkIndex    Int
  embedding     Unsupported("vector(768)")?
  metadata      Json?
  createdAt     DateTime @default(now())

  document LegalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([chunkIndex])
  @@map("legal_chunks")
}

// ---------------------------------------------------------------------------
// legal_sources — provenance / citation info for a legal document
// ---------------------------------------------------------------------------
model LegalSource {
  id             String    @id @default(cuid())
  documentId     String
  name           String
  authority      String?
  url            String?
  sourceType     String // e.g. "official_gazette", "legislative_body", "court"
  isOfficial     Boolean   @default(false)
  lastVerifiedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  document LegalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([sourceType])
  @@map("legal_sources")
}

// ---------------------------------------------------------------------------
// conversations — a chat session
// ---------------------------------------------------------------------------
model Conversation {
  id        String   @id @default(cuid())
  userId    String?
  caseId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages  Message[]
  user      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  case      Case?          @relation(fields: [caseId], references: [id], onDelete: SetNull)
  documents UserDocument[]

  @@index([caseId])
  @@index([userId, caseId])
  @@map("conversations")
}

// ---------------------------------------------------------------------------
// messages — a single message within a conversation
// ---------------------------------------------------------------------------
model Message {
  id             String   @id @default(cuid())
  conversationId String
  role           String // "user" | "assistant" | "system"
  content        String
  language       String   @default("en")
  metadata       Json?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
  @@map("messages")
}

// ---------------------------------------------------------------------------
// Auth.js / NextAuth models — application users and sessions
// ---------------------------------------------------------------------------
model User {
  id                 String    @id @default(cuid())
  name               String?
  email              String?   @unique
  emailVerified      DateTime?
  image              String?
  preferredLanguage  String?   @default("en")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  documents     UserDocument[]
  cases         Case[]
  caseDocuments CaseDocument[]
  conversations Conversation[]
  caseFilings   CaseFiling[]

  @@map("users")
}

model Case {
  id          String    @id @default(cuid())
  userId      String
  title       String
  description String?
  category    String?
  subCategory String?
  jurisdiction String?
  city        String?
  state       String?
  country     String?
  district    String?
  locality    String?
  pincode     String?
  latitude    Float?
  longitude   Float?
  // Complainant details and the latest filing analysis used by the filing agent.
  filingProfile Json?
  status      String    @default("ACTIVE")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  archivedAt  DateTime?

  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents     CaseDocument[]
  timeline      CaseTimelineEvent[]
  importantDates CaseImportantDate[]
  conversations Conversation[]
  filings       CaseFiling[]

  @@index([userId, updatedAt])
  @@index([userId, status])
  @@map("cases")
}

model CaseDocument {
  id                  String    @id @default(cuid())
  caseId              String
  userId              String
  fileName            String
  fileType            String
  fileSize            Int
  storageKey          String
  checksum            String
  extractedTextStatus String    @default("PENDING")
  extractedText       String?
  pageCount           Int?
  metadata            Json?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, checksum])
  @@index([caseId, createdAt])
  @@index([userId, deletedAt])
  @@map("case_documents")
}

model CaseTimelineEvent {
  id          String   @id @default(cuid())
  caseId      String
  type        String
  title       String
  description String?
  occurredAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, occurredAt])
  @@map("case_timeline_events")
}

model CaseImportantDate {
  id                 String   @id @default(cuid())
  caseId             String
  title              String
  description        String?
  date               DateTime
  reminderPreference String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, date])
  @@map("case_important_dates")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  sessionToken String   @id
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------------
// user_documents — generated legal drafts owned by an application user
// ---------------------------------------------------------------------------
model UserDocument {
  id                   String   @id @default(cuid())
  userId               String
  conversationId       String?
  title                String
  templateId           String
  documentType         String
  jurisdictionCountry  String
  jurisdictionRegion   String?
  status               String
  currentVersionNumber Int      @default(1)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation?         @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  versions     UserDocumentVersion[]

  @@index([userId, updatedAt])
  @@index([userId, status])
  @@index([conversationId])
  @@map("user_documents")
}

model UserDocumentVersion {
  id            String   @id @default(cuid())
  documentId    String
  versionNumber Int
  status        String
  title         String
  input         Json
  sections      Json
  warnings      Json
  citations     Json
  evidence      Json?
  generation    Json?
  createdAt     DateTime @default(now())

  document UserDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, versionNumber])
  @@index([documentId])
  @@map("user_document_versions")
}

// ---------------------------------------------------------------------------
// court_cases — official court judgments and authoritative case law
// ---------------------------------------------------------------------------
model CourtCase {
  id              String   @id
  title           String
  court           String
  courtLevel      String   // e.g. "SUPREME_COURT", "HIGH_COURT", "TRIBUNAL"
  jurisdiction    String   // e.g. "NATIONAL", "TAMIL_NADU", "DELHI"
  caseNumber      String
  caseType        String
  judgmentDate    DateTime
  bench           String?
  judgeNames      Json     // Array of judge names
  petitioner      String?
  respondent      String?
  citation        String?
  officialSource  Boolean  @default(true)
  sourceAuthority String   // e.g. "Supreme Court of India (DigiSCR)", "eCourts"
  sourceUrl       String
  sourceType      String   @default("JUDGMENT")
  acts            Json     // Array of canonical Acts
  sections        Json     // Array of sections discussed
  legalTopics     Json     // Array of topics
  primaryIssue    String
  factsSummary    String
  holding         String
  disposition     String?
  contentHash     String   @unique
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  chunks          CourtCaseChunk[]
  laws            CourtCaseLaw[]

  @@index([courtLevel])
  @@index([jurisdiction])
  @@index([judgmentDate])
  @@index([contentHash])
  @@map("court_cases")
}

// ---------------------------------------------------------------------------
// court_case_chunks — structured chunks of court judgments with embeddings
// ---------------------------------------------------------------------------
model CourtCaseChunk {
  id         String   @id
  caseId     String
  chunkIndex Int
  chunkType  String   // "HOLDING" | "FACTS" | "ISSUE" | "REASONING" | "ORDER"
  content    String
  embedding  Unsupported("vector(768)")?
  metadata   Json?
  createdAt  DateTime @default(now())

  courtCase  CourtCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([chunkType])
  @@index([chunkIndex])
  @@map("court_case_chunks")
}


// ---------------------------------------------------------------------------
// court_case_laws — which Act/section a stored judgment is authority for.
// lawKey is "<ACT_ID>:<SECTION>" (e.g. "BNS2023:103") or "<ACT_ID>" for an
// Act as a whole, matching legal_documents.metadata->>'act_id'.
// ---------------------------------------------------------------------------
model CourtCaseLaw {
  id            String   @id @default(cuid())
  caseId        String
  lawKey        String
  actId         String
  sectionNumber String?
  isLandmark    Boolean  @default(false)
  relevanceNote String?
  origin        String   // "CURATED" | "SEED" | "DISCOVERED"
  createdAt     DateTime @default(now())

  courtCase CourtCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([caseId, lawKey])
  @@index([lawKey])
  @@index([actId, isLandmark])
  @@map("court_case_laws")
}

// ---------------------------------------------------------------------------
// research_law_lookups — when official case discovery last ran for a law key,
// so repeat research on the same law is served from the database.
// ---------------------------------------------------------------------------
model ResearchLawLookup {
  lawKey           String    @id
  actId            String
  sectionNumber    String?
  status           String    // "FOUND" | "NONE_FOUND" | "FAILED"
  mode             String    // "LANDMARK" (seeded) | "QUERY" (user research)
  caseCount        Int       @default(0)
  proposedCount    Int       @default(0)
  hitCount         Int       @default(0)
  lastDiscoveredAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([actId])
  @@map("research_law_lookups")
}

// ---------------------------------------------------------------------------
// research_queries — cached articulation and case results per research query
// ---------------------------------------------------------------------------
model ResearchQuery {
  id           String    @id @default(cuid())
  queryKey     String    @unique
  query        String
  lawKeys      Json
  caseIds      Json
  articulation Json?
  hitCount     Int       @default(1)
  discoveredAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("research_queries")
}


// ---------------------------------------------------------------------------
// case_filings — complaints and petitions the filing agent drafted for a case.
// kind is an office or court id from rag-engine/complaints/taxonomy.py.
// ---------------------------------------------------------------------------
model CaseFiling {
  id          String   @id @default(cuid())
  caseId      String
  userId      String
  kind        String
  forum       String // "authority" | "court"
  title       String
  subject     String
  addressee   String
  body        String
  recipients  Json // [{ name, email, ... }] chosen by the user
  cc          Json?
  sections    Json
  citations   Json
  warnings    Json
  placeholders Json
  filing      Json // channel, portal, caveat, notes
  emailBody   String
  language    String   @default("en")
  status      String   @default("DRAFT") // DRAFT | FINAL | SENT | FILED
  generation  Json?
  sentAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([caseId, createdAt])
  @@index([userId, updatedAt])
  @@map("case_filings")
}

// ---------------------------------------------------------------------------
// authority_contacts — cached official contact lookups (managed by rag-engine).
// Emails are stored only when they were found on an official page.
// ---------------------------------------------------------------------------
model AuthorityContact {
  lookupKey String   @id
  kind      String
  state     String?
  district  String?
  locality  String?
  status    String // FOUND | NONE_FOUND | FAILED
  offices   Json
  checkedAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind, state, district])
  @@map("authority_contacts")
}

// ---------------------------------------------------------------------------
// drafting_templates — complaint / petition formats (legal_corpus/drafting_templates)
// with section-level embeddings for the filing agent (managed by rag-engine).
// ---------------------------------------------------------------------------
model DraftingTemplate {
  id           String   @id
  slug         String   @unique
  kind         String
  forum        String
  title        String
  documentType String
  courtSubject String?
  sources      Json
  content      String
  contentHash  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  chunks DraftingTemplateChunk[]

  @@index([kind])
  @@map("drafting_templates")
}

model DraftingTemplateChunk {
  id         String   @id
  templateId String
  chunkIndex Int
  heading    String
  content    String
  embedding  Unsupported("vector(768)")?
  createdAt  DateTime @default(now())

  template DraftingTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@map("drafting_template_chunks")
}
